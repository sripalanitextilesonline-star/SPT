{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Keep ISR bindings in sync with wrangler.workers.new-account.jsonc.
  "name": "sri-palani-textiles",
  "account_id": "aaa80267f9d75b8a485ef7139a1e9256",
  "main": ".open-next/worker.js",
  "minify": true,
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "sripalanitextiles.com",
      "custom_domain": true
    },
    {
      "pattern": "www.sripalanitextiles.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "sri-palani-textiles"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "spt-cdn"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "spt-next-cache"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-opennext-cache-queue",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
