# Sri Palani Textiles — copy to .env.local and fill with YOUR new project values.
# Never commit real secrets. Never reuse another shop's Supabase / R2 / Vercel keys.

# Supabase
NEXT_PUBLIC_SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_SERVICE_ROLE=

# Database — pooler URI (port 6543)
DATABASE_URL=
# Optional: SUPABASE_DB_POOLER_URL=  SUPABASE_DB_REGION=ap-south-1  SUPABASE_DB_AWS_PREFIX=aws-1

# AWS S3 / Cloudflare R2
NEXT_PUBLIC_S3_BUCKET=
NEXT_PUBLIC_S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
NEXT_PUBLIC_CDN_URL=

# Payments: Cashfree — configure in Admin → Integrations (no Stripe)

# Deployment
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Guest order access tokens (required in production)
ORDER_ACCESS_SECRET=

# Dispatch emails (Resend) — optional; dispatch still works without email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Auth rate limiting (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — external cron
CRON_SECRET=

# Optional — Google OAuth via Supabase Auth
# SUPABASE_ACCESS_TOKEN=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional — Velo order push (configure after you own the endpoint)
# VELO_PUSH_SECRET=
# VELO_PUSH_URL=
# VELO_PUSH_SHOP_BASE_URL=

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Local builds only — omit in production once all vars above are set
# SKIP_ENV_VALIDATION=true
